# ==============================================================
# Shared Self-Attendance Tracker — Environment Configuration
# ==============================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Secret Key for Session Authentication (Use a secure random string in production)
JWT_SECRET=super-secret-jwt-attendance-key-change-in-production-2026

# Database Type: 'sqlite' (default, zero configuration) or 'postgres'
DB_TYPE=sqlite

# SQLite Database Storage File Path (Used when DB_TYPE=sqlite)
SQLITE_DB_PATH=./data/attendance.db

# PostgreSQL / Supabase Connection URI (Optional: Used when DB_TYPE=postgres)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Default Attendance Minimum Target Percentage (Default: 75)
DEFAULT_ATTENDANCE_TARGET=75
