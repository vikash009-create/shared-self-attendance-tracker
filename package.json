{
  "name": "shared-self-attendance-tracker",
  "version": "1.0.0",
  "description": "Full-Stack Shared Self-Attendance Tracker for Students",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "node scripts/dev.js",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:client && npm run build:server",
    "start": "npm run start --prefix server",
    "seed": "npm run seed --prefix server",
    "test": "npm run test --prefix server",
    "package": "python scripts/package_zip.py"
  },
  "keywords": [
    "attendance-tracker",
    "student-tool",
    "attendance-calculator",
    "react",
    "express",
    "typescript",
    "sqlite",
    "supabase"
  ],
  "author": "GDSC Team",
  "license": "MIT"
}
